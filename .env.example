# ============================================================
# cvat-sam2 environment configuration
# Copy this file to .env and adjust values as needed.
# WARNING: Never commit .env with real secrets to version control.
# ============================================================

# ------------------------------------------------------------
# CVAT
# ------------------------------------------------------------
# Version of CVAT to use (Docker Hub image tag)
CVAT_VERSION=v2.20.0

# CVAT superuser credentials — change before first start
CVAT_SUPERUSER_EMAIL=admin@example.com
CVAT_SUPERUSER_PASS=ChangeMeNow123!

# Port on which CVAT is accessible on the host (localhost only)
CVAT_PORT=8080

# Internal CVAT host used by serverless functions to call the CVAT API
CVAT_HOST=cvat_server

# Nuclio dashboard port (localhost only)
NUCLIO_PORT=8070

# ------------------------------------------------------------
# Database / Redis
# ------------------------------------------------------------
POSTGRES_DB=cvat
POSTGRES_USER=root
POSTGRES_PASSWORD=cvat_db_password_change_me

# ------------------------------------------------------------
# SAM2 service
# ------------------------------------------------------------
# Model variant: tiny | small | base_plus | large
SAM2_MODEL_ID=large

# Device: auto | cuda | cpu
# "auto" detects GPU availability at runtime
SAM2_DEVICE=auto

# Port for the SAM2 HTTP inference service
SAM2_PORT=8000

# HuggingFace / SAM2 model cache directory inside the container
SAM2_MODEL_CACHE=/models/sam2_cache

# ------------------------------------------------------------
# ONNX runner
# ------------------------------------------------------------
# Port for the ONNX model runner HTTP service
ONNX_PORT=8001

# Device: auto | cuda | cpu
ONNX_DEVICE=auto

# Directory inside the container where user models are mounted
ONNX_MODELS_DIR=/models/user

# ------------------------------------------------------------
# Compose project
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=cvat-sam2
